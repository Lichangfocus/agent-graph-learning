    "log": "tsx engine/pipeline/log-event.ts",
    "schema:gen": "tsx engine/pipeline/generate-json-schema.ts",
    "units:validate": "tsx engine/pipeline/validate-units.ts",
    "graph:validate": "tsx engine/pipeline/validate-graph.ts",
    "assets:download": "tsx engine/pipeline/download-assets.ts",
    "exports:build": "tsx engine/pipeline/build-exports.ts",
    "video:render": "tsx engine/pipeline/render-video.ts",
    "course:build": "tsx engine/pipeline/build-course-index.ts",
