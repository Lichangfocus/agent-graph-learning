{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./apps/web/*"],
      "@engine/*": ["./engine/*"]
    }
  },
  "include": ["engine/**/*.ts", "tests/**/*.ts", "apps/web/**/*.ts", "apps/web/**/*.tsx"],
  "exclude": ["node_modules", "apps/web/.next", "demo", "maps", "my"]
}
